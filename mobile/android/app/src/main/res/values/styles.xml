<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- The bar above the page is the window, not the WebView. Below
             WebView 140 Capacitor pads the WebView down by the inset instead
             of laying it under the bar, so whatever this paints is a strip the
             page cannot reach. Matching the page background removes the seam.
             The icons are a separate switch: on the light background they have
             to go dark to stay visible. Both values follow the system theme.
             windowBackground matters too: Capacitor's SystemBars plugin copies
             this attribute onto the decor view on every bridge init, so
             leaving it at the AppCompat/splash default painted a second,
             darker band that statusBarColor alone could not reach. -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">@bool/status_bar_icons_dark</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/launch_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">@bool/status_bar_icons_dark</item>
    </style>

    <!-- The pairing sheet is a translucent surface over the app. It paints its
         own status-bar strip, so the window has to draw the system bars and
         stay clear everywhere else; the platform translucent theme leaves the
         bar to the system, which on API 35+ draws a black one above it. -->
    <style name="PairTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- The platform translucent theme opts out of API 35's edge-to-edge
             enforcement on some builds; that leaves the sheet below an opaque
             system bar. The sheet paints its own bar strip, so it wants the
             edge-to-edge layout. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
